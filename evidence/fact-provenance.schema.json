{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./fact-provenance.schema.json",
  "title": "Vex Hospital Fact Provenance Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "policy_version",
    "fact_rules"
  ],
  "properties": {
    "schema_ref": {
      "const": "./fact-provenance.schema.json"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "fact_rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applies_when",
          "requirements"
        ],
        "properties": {
          "applies_when": {
            "type": "boolean"
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "producer_roles",
                "results",
                "min_count"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "producer_roles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "results": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "min_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "requires_fresh_context": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
