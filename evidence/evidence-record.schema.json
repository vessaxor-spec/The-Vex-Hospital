{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./evidence-record.schema.json",
  "title": "Vex Hospital Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "case_id",
    "kind",
    "producer_role",
    "subject",
    "result",
    "synthetic",
    "visibility"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[A-Z0-9-]+$"
    },
    "kind": {
      "enum": [
        "authorization",
        "diagnosis",
        "treatment_result",
        "self_test",
        "independent_verification",
        "adversarial_verification",
        "resilience_verification",
        "regression_review",
        "discharge_review",
        "residual_risk_review",
        "runtime_observation",
        "repository_inspection",
        "other"
      ]
    },
    "producer_role": {
      "enum": [
        "authorized_operator",
        "platform_authority",
        "case_orchestrator",
        "treating_agent",
        "independent_verifier",
        "adversarial_verifier",
        "resilience_verifier",
        "runtime",
        "tool",
        "ci_harness",
        "external_evaluator"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "observed",
        "granted",
        "denied",
        "not_applicable"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "visibility": {
      "enum": [
        "synthetic_public",
        "sanitized_reference",
        "local_private"
      ]
    },
    "fresh_context": {
      "type": "boolean"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
